{
  "name": "spotlight-serif",
  "description": "Monochrome spotlight with Instrument Serif headlines (upright only)",
  "palette": {
    "bg": "#000000",
    "bg2": "#0c0c0c",
    "fg": "#ffffff",
    "muted": "#9a9a9a",
    "accent": "#ffffff",
    "accent2": "#ffffff",
    "onAccent": "#000000",
    "eyebrow": "#9a9a9a",
    "chrome": "#121212",
    "frameGlow": "rgba(255,255,255,0.07)",
    "dim": "#5e5e5e"
  },
  "highlight": "spotlight",
  "background": "spotlight",
  "glow": 0.09,
  "grain": 0.06,
  "vignette": 0.6,
  "cornerMark": true,
  "motion": {
    "ease": "expo",
    "text": "mask",
    "transition": "fade-zoom"
  },
  "font": {
    "display": "Instrument Serif",
    "body": "Instrument Sans",
    "mono": "JetBrains Mono",
    "weightDisplay": 400,
    "tracking": "-0.025em",
    "trackingSmall": "-0.01em",
    "leading": 0.98,
    "files": [
      {
        "family": "Instrument Serif",
        "src": "fonts/InstrumentSerif-Regular.ttf",
        "weight": 400
      },
      {
        "family": "Instrument Sans",
        "src": "fonts/InstrumentSans-Regular.ttf",
        "weight": 400
      },
      {
        "family": "Instrument Sans",
        "src": "fonts/InstrumentSans-Bold.ttf",
        "weight": 700
      }
    ],
    "scale": 1.32
  }
}
